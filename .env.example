
# Required — get this from platform.claude.com > Settings > API keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — SPARQL endpoint the app queries. Defaults shown below.
FUSEKI_ENDPOINT=https://lod.sztaki.hu/sparql
FUSEKI_TIMEOUT=75

# Optional — max tokens per LLM response.
LLM_MAX_TOKENS=1200

# Optional — Flask session signing key. If unset, a random one is generated
# on every restart, which invalidates existing sessions. Set a fixed value
# for production so sessions survive a redeploy.
FLASK_SECRET_KEY=change-me-to-a-random-string

# Optional — path to the local SQLite memory/checkpoint database.
MEMORY_DB=memory.db
